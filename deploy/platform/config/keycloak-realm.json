{
  "realm": "agent-platform",
  "enabled": true,
  "displayName": "Agent Workspace",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "sslRequired": "external",
  "clients": [
    {
      "clientId": "agent-platform-web",
      "name": "Agent Workspace Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["https://${PUBLIC_HOST}/*"],
      "webOrigins": ["https://${PUBLIC_HOST}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://${PUBLIC_HOST}/*"
      },
      "protocolMappers": [
        {
          "name": "agent-platform-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "agent-platform-api",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "agent-workspace-admin",
      "name": "Agent Workspace account administration",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${KEYCLOAK_SERVICE_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "username": "platform-admin",
      "email": "platform-admin@agent-workspace.local",
      "firstName": "Platform",
      "lastName": "Administrator",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${PLATFORM_ADMIN_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ]
}
