POSTGRES_IMAGE=postgres:17.6-alpine
POSTGRES_DB=agent_platform
POSTGRES_USER=agent_platform
POSTGRES_PASSWORD=replace-with-a-long-random-secret

MINIO_IMAGE=minio/minio@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e
MINIO_ROOT_USER=agent-platform
MINIO_ROOT_PASSWORD=replace-with-a-long-random-secret
MINIO_BUCKET=agent-platform

HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80

# Required by compose.https.yaml. Keep passwords only in the external env file.
PUBLIC_HOST=agent-platform.example.test
ACME_EMAIL=platform-operations@example.test
CADDY_IMAGE=caddy@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak@sha256:f1f1f01e472c8a78df40d8f2a49a925274eda4d3d80d5f6edbb5c880ee3c01c6
KEYCLOAK_POSTGRES_IMAGE=postgres@sha256:ef257d85f76e48da1c64832459b59fcaba1a4dac97bf5d7450c77753542eee94
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=replace-with-a-long-random-secret
KEYCLOAK_ADMIN_USER=platform-bootstrap
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-secret
OIDC_REALM_FILE=/opt/agent-platform/config/keycloak-realm.json

VITE_OIDC_AUTHORITY=https://agent-platform.example.test/identity/realms/agent-platform
VITE_OIDC_CLIENT_ID=agent-platform-web
VITE_OIDC_REDIRECT_URI=https://agent-platform.example.test/auth/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=https://agent-platform.example.test
OIDC_ISSUER=https://agent-platform.example.test/identity/realms/agent-platform
OIDC_AUDIENCE=agent-platform-api
OIDC_ORGANIZATION_CLAIM=organization
