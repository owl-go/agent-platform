{
    email {$ACME_EMAIL}
    servers {
        timeouts {
            read_body 30s
            read_header 10s
            idle 1h
        }
    }
}

{$PUBLIC_HOST} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    handle /api/healthz {
        rewrite * /healthz
        reverse_proxy api:8080 {
            transport http {
                dial_timeout 5s
                response_header_timeout 10s
                keepalive 30s
            }
        }
    }

    handle /api/readyz {
        rewrite * /readyz
        reverse_proxy api:8080 {
            transport http {
                dial_timeout 5s
                response_header_timeout 10s
                keepalive 30s
            }
        }
    }

    handle /api/* {
        reverse_proxy api:8080 {
            flush_interval -1
            transport http {
                dial_timeout 5s
                response_header_timeout 10s
                keepalive 30s
            }
        }
    }

    handle /identity/* {
        reverse_proxy identity:8080 {
            transport http {
                dial_timeout 5s
                response_header_timeout 10s
                keepalive 30s
            }
        }
    }

    handle_path /model-relay/* {
        @missingAuthorization not header Authorization *
        respond @missingAuthorization 404
        reverse_proxy {$MODEL_RELAY_UPSTREAM:http://host.docker.internal:3000} {
            transport http {
                dial_timeout 5s
                response_header_timeout 5m
                keepalive 30s
            }
        }
    }

    handle {
        reverse_proxy web:8080 {
            transport http {
                dial_timeout 5s
                response_header_timeout 10s
                keepalive 30s
            }
        }
    }
}
