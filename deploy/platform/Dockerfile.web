# syntax=docker/dockerfile:1

FROM public.ecr.aws/docker/library/node:24.15.0-bookworm-slim@sha256:4e6b70dd6cbfc88c8157ba19aa3d9f9cce6ba4703576d55459e45efcbc9c5f5d AS build

WORKDIR /src/frontend
RUN corepack enable && corepack prepare pnpm@11.19.0 --activate
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY frontend .
RUN pnpm build

FROM public.ecr.aws/docker/library/nginx:1.29-alpine

COPY deploy/platform/nginx.conf /etc/nginx/nginx.conf
COPY --from=build --chown=101:101 /src/frontend/dist /usr/share/nginx/html

USER 101:101
EXPOSE 8080
