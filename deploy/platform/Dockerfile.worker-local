# syntax=docker/dockerfile:1
FROM public.ecr.aws/docker/library/golang:1.25-bookworm AS build
WORKDIR /src
COPY backend/go.mod backend/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY backend .
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/worker ./cmd/worker

FROM public.ecr.aws/docker/library/alpine:3.23
RUN apk add --no-cache ca-certificates docker-cli git openssh-client tzdata
COPY --from=build /out/worker /usr/local/bin/worker
COPY resources.json /app/resources/resources.json
COPY connectors /app/resources/connectors
COPY skills /app/resources/skills
COPY experts /app/resources/experts
ENV AGENT_WORKSPACE_RESOURCE_ROOT=/app/resources
# This control process needs Docker access and ownership changes. Runtime
# containers it creates still run as 65532 with no capabilities.
USER 0:0
ENTRYPOINT ["/usr/local/bin/worker"]
