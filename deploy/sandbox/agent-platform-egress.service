[Unit]
Description=Agent Platform public-only sandbox egress policy
Requires=docker.service
After=docker.service
PartOf=docker.service

[Service]
Type=oneshot
EnvironmentFile=-/srv/agent-workspace/config/egress.env
ExecStart=/srv/agent-workspace/src/deploy/sandbox/configure-public-egress.sh
RemainAfterExit=yes

[Install]
WantedBy=docker.service
