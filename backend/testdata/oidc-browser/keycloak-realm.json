{
  "realm": "agent-platform",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "agent-platform-web",
      "name": "Agent Platform Browser Acceptance",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://127.0.0.1:18092/auth/callback"],
      "attributes": {
        "post.logout.redirect.uris": "http://127.0.0.1:18092/*"
      },
      "webOrigins": ["http://127.0.0.1:18092"],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "organization",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "organization",
            "claim.value": "acme",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "agent-platform-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "agent-platform-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "username": "platform-user",
      "email": "platform-user@example.test",
      "firstName": "Platform",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "acceptance-only-password",
          "temporary": false
        }
      ]
    }
  ]
}
